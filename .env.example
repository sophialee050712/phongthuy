# Supabase — lấy từ Supabase Dashboard → Project Settings → API (khi có project thật).
# Chưa có key thì web vẫn chạy ở chế độ dev với dữ liệu mẫu local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL public của site khi deploy (dùng cho canonical, sitemap, JSON-LD).
# Ví dụ: https://khang-an-phong-thuy.vn
NEXT_PUBLIC_SITE_URL=
